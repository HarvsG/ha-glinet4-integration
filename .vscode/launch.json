{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Python: Debug Current Test File",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": ["${file}", "-s", "-vv"],
      "console": "integratedTerminal",
      "justMyCode": false
    },
    {
      "name": "Python: Debug All Tests",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": ["tests", "-vv"],
      "console": "integratedTerminal",
      "justMyCode": false
    }
  ]
}
